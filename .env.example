# MongoDB Atlas connection string. URL-encode reserved password characters (e.g. @ becomes %40).
MONGODB_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/nidhi_little_world?retryWrites=true&w=majority

# Admin credentials are generated for local development. Change before public deployment.
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX_SECRET
API_PORT=4000
NODE_ENV=development
